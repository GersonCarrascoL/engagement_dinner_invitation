---
import "../styles/global.css";
import HeartIcon from "../components/HeartIcon.astro";

interface Props {
  title?: string;
}

const { title = "Anais & Gerson — Nuestro compromiso" } = Astro.props;

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/{2,}/g, "/");

const youtubeVideoId = "jamgjQ-CTI8";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="180x180" href={withBase("favicon-180.png")} />
    <link rel="apple-touch-icon" href={withBase("favicon-180.png")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper">
    <div
      id="cover"
      class="fixed inset-0 z-50 overflow-hidden bg-paper"
      style="perspective: 1600px;"
    >
      <div
        id="cover-left"
        class="absolute inset-y-0 left-0 w-1/2 overflow-hidden bg-paper shadow-[inset_-10px_0_16px_-10px_rgba(0,0,0,0.3)] transition-transform duration-[1100ms] ease-in-out"
        style="transform-origin: left center; backface-visibility: hidden;"
      >
        <div
          class="absolute inset-y-0 left-0 flex w-screen flex-col items-center justify-center gap-6 px-6 text-center"
          aria-hidden="true"
        >
          <span class="font-script text-5xl text-ink md:text-6xl">
            G <span class="font-serif text-3xl text-accent italic md:text-4xl">&amp;</span> A
          </span>
          <span class="border-t border-ink pt-4 font-serif text-xs tracking-[0.2em] text-ink uppercase md:text-sm">
            Toca para abrir tu invitación
          </span>
          <HeartIcon size={30} />
        </div>
      </div>

      <div
        id="cover-right"
        class="absolute inset-y-0 right-0 w-1/2 overflow-hidden bg-paper shadow-[inset_10px_0_16px_-10px_rgba(0,0,0,0.3)] transition-transform duration-[1100ms] ease-in-out"
        style="transform-origin: right center; backface-visibility: hidden;"
      >
        <div
          class="absolute inset-y-0 right-0 flex w-screen flex-col items-center justify-center gap-6 px-6 text-center"
          aria-hidden="true"
        >
          <span class="font-script text-5xl text-ink md:text-6xl">
            G <span class="font-serif text-3xl text-accent italic md:text-4xl">&amp;</span> A
          </span>
          <span class="border-t border-ink pt-4 font-serif text-xs tracking-[0.2em] text-ink uppercase md:text-sm">
            Toca para abrir tu invitación
          </span>
          <HeartIcon size={30} />
        </div>
      </div>

      <button
        id="cover-button"
        type="button"
        class="absolute inset-0 z-10"
        aria-label="Abrir la invitación y reproducir la canción"
      ></button>
    </div>

    <div id="yt-player" class="hidden"></div>

    <slot />

    <script define:vars={{ youtubeVideoId }}>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduceMotion) {
        revealItems.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        revealItems.forEach((el) => observer.observe(el));
      }

      const cover = document.getElementById("cover");
      const coverLeft = document.getElementById("cover-left");
      const coverRight = document.getElementById("cover-right");
      const coverButton = document.getElementById("cover-button");
      const musicToggle = document.getElementById("music-toggle");
      const playIcon = document.getElementById("icon-play");
      const pauseIcon = document.getElementById("icon-pause");

      document.body.style.overflow = "hidden";

      let player = null;
      let playerReady = false;
      let pendingPlay = false;

      const setPlayingUI = (isPlaying) => {
        if (!playIcon || !pauseIcon) return;
        playIcon.classList.toggle("hidden", isPlaying);
        pauseIcon.classList.toggle("hidden", !isPlaying);
        if (musicToggle) {
          musicToggle.setAttribute(
            "aria-label",
            isPlaying ? "Pausar canción" : "Reproducir canción",
          );
        }
      };

      const openCover = () => {
        coverButton.style.pointerEvents = "none";
        coverLeft.style.transform = "rotateY(-100deg)";
        coverRight.style.transform = "rotateY(100deg)";
        document.body.style.overflow = "";
        if (playerReady) {
          player.playVideo();
        } else {
          pendingPlay = true;
        }
        window.setTimeout(() => cover.remove(), 1100);
      };

      coverButton?.addEventListener("click", openCover);

      musicToggle?.addEventListener("click", () => {
        if (!playerReady) return;
        const state = player.getPlayerState();
        if (state === YT.PlayerState.PLAYING) {
          player.pauseVideo();
        } else {
          player.playVideo();
        }
      });

      window.onYouTubeIframeAPIReady = () => {
        player = new YT.Player("yt-player", {
          videoId: youtubeVideoId,
          playerVars: {
            playsinline: 1,
            loop: 1,
            playlist: youtubeVideoId,
            start: 5,
          },
          events: {
            onReady: () => {
              playerReady = true;
              if (pendingPlay) player.playVideo();
            },
            onStateChange: (event) => {
              setPlayingUI(event.data === YT.PlayerState.PLAYING);
              if (
                event.data === YT.PlayerState.PLAYING &&
                player.getCurrentTime() < 1
              ) {
                player.seekTo(5, true);
              }
            },
          },
        });
      };

      const ytScript = document.createElement("script");
      ytScript.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(ytScript);
    </script>
  </body>
</html>
