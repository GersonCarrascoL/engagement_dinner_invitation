---
import "../styles/global.css";
import HeartIcon from "../components/HeartIcon.astro";

interface Props {
  title?: string;
}

const { title = "Gerson & Anais — Nuestro compromiso" } = Astro.props;

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/{2,}/g, "/");

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase("favicon-32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="180x180"
      href={withBase("favicon-180.png")}
    />
    <link rel="apple-touch-icon" href={withBase("favicon-180.png")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <style>
      body {
        opacity: 0;
        background: #f7f3ea;
        transition: opacity 0.6s ease;
      }
      body.is-loaded {
        opacity: 1;
      }
    </style>
  </head>
  <body class="bg-paper">
    <div
      id="cover"
      class="fixed inset-0 z-50 flex items-center justify-center bg-paper transition-opacity duration-700 ease-in-out"
    >
      <button
        id="cover-button"
        type="button"
        class="flex flex-col items-center gap-6 px-6 text-center"
        aria-label="Abrir la invitación y reproducir la canción"
      >
        <span
          class="font-script inline-block -translate-x-[0.12em] text-5xl text-ink md:text-6xl"
        >
          G <span class="font-serif text-3xl text-accent italic md:text-4xl"
            >&amp;</span
          > A
        </span>
        <span
          class="border-t border-ink pt-4 font-serif text-xs tracking-[0.2em] text-ink uppercase md:text-sm"
        >
          Toca para abrir tu invitación
        </span>
        <HeartIcon size={30} />
      </button>
    </div>

    <audio id="bg-audio" src={withBase("audio/besame.mp3")} loop preload="auto"></audio>

    <div
      id="page-content"
      class="opacity-0 transition-opacity duration-700 ease-in-out"
    >
      <slot />
    </div>

    <script>
      document.body.classList.add("is-loaded");

      const revealItems = document.querySelectorAll("[data-reveal]");
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduceMotion) {
        revealItems.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        revealItems.forEach((el) => observer.observe(el));
      }

      const cover = document.getElementById("cover");
      const pageContent = document.getElementById("page-content");
      const coverButton = document.getElementById("cover-button");
      const musicToggle = document.getElementById("music-toggle");
      const playIcon = document.getElementById("icon-play");
      const pauseIcon = document.getElementById("icon-pause");
      const eqBars = document.querySelectorAll(".eq-bars");

      document.body.style.overflow = "hidden";

      const audio = document.getElementById("bg-audio");

      const setPlayingUI = (isPlaying) => {
        if (!playIcon || !pauseIcon) return;
        playIcon.classList.toggle("hidden", isPlaying);
        pauseIcon.classList.toggle("hidden", !isPlaying);
        eqBars.forEach((el) => {
          el.style.opacity = isPlaying ? "1" : "0";
        });
        if (musicToggle) {
          musicToggle.setAttribute(
            "aria-label",
            isPlaying ? "Pausar canción" : "Reproducir canción",
          );
        }
      };

      audio?.addEventListener("play", () => setPlayingUI(true));
      audio?.addEventListener("pause", () => setPlayingUI(false));

      const openCover = () => {
        coverButton.style.pointerEvents = "none";
        cover.style.opacity = "0";
        audio?.play();
        window.setTimeout(() => {
          cover.remove();
          document.body.style.overflow = "";
          pageContent.style.opacity = "1";
        }, 700);
      };

      coverButton?.addEventListener("click", openCover);

      musicToggle?.addEventListener("click", () => {
        if (!audio) return;
        if (audio.paused) {
          audio.play();
        } else {
          audio.pause();
        }
      });
    </script>
  </body>
</html>
