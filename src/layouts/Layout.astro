---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Anais & Gerson — Nuestro compromiso" } = Astro.props;

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/{2,}/g, "/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="180x180" href={withBase("favicon-180.png")} />
    <link rel="apple-touch-icon" href={withBase("favicon-180.png")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper">
    <slot />
    <script>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduceMotion) {
        revealItems.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        revealItems.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
