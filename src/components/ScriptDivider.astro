---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3 md:gap-4", className]}>
  <div class="border-t border-ink flex-1"></div>
  <span class="font-script text-4xl md:text-5xl text-ink pb-1">{label}</span>
  <div class="border-t border-ink flex-1"></div>
</div>
