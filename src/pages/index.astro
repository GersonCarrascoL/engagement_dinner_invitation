---
import HeartIcon from "../components/HeartIcon.astro";
import Masthead from "../components/Masthead.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import ScriptDivider from "../components/ScriptDivider.astro";
import Layout from "../layouts/Layout.astro";

const address = "Asociación Perpetuo Socorro, Mz A Lote H, Ate, Lima, Perú";
const mapsUrl = `https://maps.app.goo.gl/kpkVMsmqLgGYLS7L6`;
---

<Layout>
  <main class="mx-auto max-w-[1440px] bg-paper">
    <!-- <div class="px-4 pt-6 md:px-12 md:pt-10 lg:px-[90px] lg:pt-12">
      <div class="border-t-2 border-ink md:border-t-[3px]"></div>
      <div class="mt-1 border-t border-ink"></div>
    </div> -->

    <Masthead
      names={"Anais Aponte &\nGerson Carrasco"}
      eventLabel={"Noticia de\núltima hora"}
      date={"Domingo\n30 Agosto, 2026"}
    />

    <div class="px-4 md:px-12 lg:px-[90px]">
      <div class="border-t-2 border-ink md:border-t-[3px]"></div>
      <div class="mt-1 border-t border-ink"></div>
    </div>

    <h1
      class="text-balance px-4 py-6 text-center font-display text-[38px] leading-[1.08] text-ink md:px-12 md:py-8 md:text-6xl lg:px-[90px] lg:py-9 lg:text-8xl"
    >
      ANAIS DIJO S&Iacute; A GERSON
    </h1>

    <div class="px-4 pb-8 md:px-12 md:pb-10 lg:px-[90px] lg:pb-12">
      <div class="border-t-2 border-ink md:border-t-[3px]"></div>
      <div class="mt-1 border-t border-ink"></div>
    </div>

    <div class="px-4 pb-8 md:px-12 md:pb-10 lg:px-[90px] lg:pb-14">
      <div class="lg:grid lg:grid-cols-[3fr_2fr] lg:items-stretch lg:gap-12">
        <PhotoPlaceholder
          data-reveal
          class="mb-8 h-[300px] md:mb-10 md:h-[380px] lg:mb-0 lg:h-full"
        />

        <div
          class="mx-auto flex max-w-[640px] flex-col gap-8 md:gap-10 lg:mx-0 lg:max-w-none lg:gap-8"
        >
          <div data-reveal>
            <div class="border-t-2 border-ink md:border-t-[3px]"></div>
            <div class="mt-1 border-t border-ink"></div>
            <div
              class="flex items-center justify-center gap-2 py-4 md:gap-2.5 md:py-5"
            >
              <HeartIcon class="h-5 w-5 md:h-6 md:w-6 lg:h-7 lg:w-7" />
              <HeartIcon class="h-5 w-5 md:h-6 md:w-6 lg:h-7 lg:w-7" />
              <span
                class="mx-2 font-serif text-base font-bold tracking-[0.1em] text-ink uppercase whitespace-nowrap md:text-xl lg:text-2xl"
              >
                Nuestro compromiso
              </span>
              <HeartIcon class="h-5 w-5 md:h-6 md:w-6 lg:h-7 lg:w-7" />
              <HeartIcon class="h-5 w-5 md:h-6 md:w-6 lg:h-7 lg:w-7" />
            </div>
            <div class="border-t-2 border-ink md:border-t-[3px]"></div>
            <div class="mt-1 border-t border-ink"></div>
          </div>

          <div data-reveal class="border-[1.5px] border-ink px-5 py-6 md:px-8 md:py-8">
            <p
              class="text-center font-serif text-[14.5px] leading-[1.7] text-ink/90 md:text-lg md:leading-[1.8]"
            >
              &ldquo;Querida familia y amigos, queremos celebrar con ustedes de
              manera oficial que nos vamos a comprometer y esperamos que sean
              parte de este momento de felicidad. Los esperamos para que sean
              participes de la pedida de mano mas hermosa&rdquo;
            </p>
          </div>

          <div data-reveal>
            <ScriptDivider label="Fecha" class="mb-3" />
            <div
              class="flex items-center justify-center rounded-md bg-[#4a4a4a] px-5 py-8 md:rounded-md md:py-10"
            >
              <span
                class="font-condensed text-3xl font-medium tracking-[0.15em] text-paper md:text-4xl"
              >
                30 / 08 / 26
              </span>
            </div>
          </div>

          <div data-reveal>
            <ScriptDivider label="Dirección" class="mb-3" />
            <div
              class="rounded-md bg-[#e3ddcd] px-6 py-8 text-center md:rounded-md md:px-10 md:py-10"
            >
              <p
                class="mb-2 font-serif text-base font-bold text-ink md:text-xl"
              >
                Hora 6:00 pm
              </p>
              <p
                class="font-serif text-sm leading-relaxed text-ink/90 md:text-lg"
              >
                Asoc. Perpetuo Socorro Mz A Lote 9 <br />Ate
              </p>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-sm mt-4 inline-flex items-center gap-2 bg-accent px-6 py-3 text-paper transition-colors hover:bg-[#4a1c1c]"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                  ></path>
                </svg>
                <span
                  class="font-condensed text-sm font-normal tracking-wider uppercase md:text-base"
                  >Ver mapa</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div data-reveal class="px-4 pb-8 md:px-12 md:pb-10 lg:px-[90px] lg:pb-12">
      <PhotoPlaceholder class="h-[300px] md:h-[380px]" />
    </div>

    <div data-reveal class="px-4 pb-8 md:px-12 md:pb-10 lg:px-[90px] lg:pb-12">
      <ScriptDivider label="¡Te esperamos!" />
    </div>

    <div data-reveal class="pb-10 text-center md:pb-14 lg:pb-16">
      <span class="font-script text-4xl text-ink md:text-5xl">
        G <span class="font-serif text-2xl text-accent italic md:text-3xl">&amp;</span> A
      </span>
    </div>
  </main>
</Layout>
